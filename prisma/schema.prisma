generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  visitorHash String    @unique @db.Char(64)
  displayName String?   @db.VarChar(60)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  memories    Memory[]
  petState    PetState?

  @@map("user_profiles")
}

model Memory {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  category   String      @db.VarChar(40)
  key        String      @db.VarChar(80)
  value      String      @db.Text
  confidence Float       @default(1)
  importance Float       @default(1)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  lastUsedAt DateTime?   @db.Timestamptz(3)
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@index([userId, updatedAt])
  @@map("memories")
}

model PetState {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique @db.Uuid
  relationshipLevel Int         @default(0)
  lastInteractionAt DateTime    @default(now()) @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  user              UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pet_states")
}
